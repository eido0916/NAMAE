NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 任意。同じオリジンまたは信頼できる監視サービスの収集URLを指定します。
NEXT_PUBLIC_MONITORING_ENDPOINT=
# 収集時のみ必須。実際のプロジェクトURLと連絡先を含むUser-Agent。
WIKIDATA_USER_AGENT=
# 省略時: 1200ms、1秒未満にはしません。
WIKIDATA_INTERVAL_MS=1200
# 任意。省略時: data/name-details.sqlite（ビルドと収集で同じ値を使う）
NAMAE_DETAILS_DB=
# npm start の未収録人物の自動収集。0で無効（静的データのみ）。省略時1。
NAMAE_LIVE_DETAILS=1
