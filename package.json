{
  "name": "whatyourname",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:build && next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests eslint.config.mjs next.config.ts",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "playwright test tests/browser.spec.ts",
    "data:build": "npm run data:check && npm run data:coverage && node scripts/build-name-database.mjs && node scripts/export-public-data.mjs && npm run data:verify",
    "data:check": "node scripts/validate-data.mjs",
    "data:accept": "node scripts/validate-data.mjs --accept",
    "data:verify": "node scripts/verify-public-data.mjs",
    "data:sanitize": "node scripts/sanitize-name-scripts.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "health:check": "node scripts/check-deployment.mjs",
    "data:refresh:foreign": "node scripts/import-foreign-rankings.mjs",
    "data:refresh:foreign-surnames": "node scripts/import-foreign-surnames.mjs",
    "data:refresh:countries": "node scripts/import-onomaverse-countries.mjs",
    "data:refresh:popular": "node scripts/import-popular-names.mjs",
    "data:refresh:us-surnames": "node scripts/import-us-census-surnames.mjs",
    "data:refresh:baby-calendar": "node scripts/import-baby-calendar.mjs",
    "data:refresh:enamdict": "node scripts/import-enamdict.mjs",
    "data:refresh:ipadic": "node scripts/import-ipadic-given-names.mjs",
    "data:refresh:official": "node scripts/import-official-expanded.mjs",
    "data:coverage": "node scripts/report-coverage.mjs",
    "data:refresh:jp-rankings": "node scripts/reconcile-japanese-rankings.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
